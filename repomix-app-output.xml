extension QcThemeIdX on QcThemeId {
  String get label {
    switch (this) {
      case QcThemeId.dark:
        return 'Dark';
      case QcThemeId.light:
        return 'Light';
      case QcThemeId.eyecare:
        return 'Eyecare';
