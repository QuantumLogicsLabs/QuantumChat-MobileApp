    bool hasAvatar = false;
    if (user is Map) {
      userId = '${user['id'] ?? user['_id'] ?? ''}';
      username = user['username'] as String? ?? 'User';
      hasAvatar = user['hasAvatar'] == true;
    } else if (user != null) {
