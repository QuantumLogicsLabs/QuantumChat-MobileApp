<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug/emulator only: Impeller OpenGLES often blacks out or drops the
         connection on x86 AVDs. Release keeps Impeller (main manifest). -->
    <application>
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false"/>
    </application>
</manifest>
